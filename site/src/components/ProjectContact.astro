---
import EmailReveal from './EmailReveal.astro';
---
<section id="contact">
  <div class="container">
    <p class="section-kicker">Get in touch</p>
    <h2 class="section-title">Interested in MEMO?</h2>
    <p class="section-sub">Interested in MEMO, a live demo, research collaboration, or exploring where the project could go next? Get in touch.</p>

    <div class="press-contact" style="margin-top: 28px;">
      <div class="press-contact-who">
        <div class="press-contact-name">Alexander Kuznetsov</div>
        <div class="press-contact-role">Project contact</div>
      </div>
      <div class="press-contact-links">
        <EmailReveal user="kuznecov.alexandr" domain="gmail.com" />
        <a href="https://www.linkedin.com/in/alexskuznetsov/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
</section>
