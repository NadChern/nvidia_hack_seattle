---
interface Props {
  user: string;
  domain: string;
}
const { user, domain } = Astro.props;
---
<span class="email-field">
  <button type="button" class="email-reveal" data-user={user} data-domain={domain}>Show email</button>
</span>

<script>
  document.querySelectorAll<HTMLElement>('.email-field').forEach((field) => {
    const revealBtn = field.querySelector<HTMLButtonElement>('.email-reveal');
    revealBtn?.addEventListener(
      'click',
      () => {
        const email = `${revealBtn.dataset.user}@${revealBtn.dataset.domain}`;

        const link = document.createElement('a');
        link.href = `mailto:${email}`;
        link.textContent = email;
        link.className = 'email-revealed';

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'email-copy';
        copyBtn.title = 'Copy email';
        copyBtn.setAttribute('aria-label', 'Copy email');
        copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(email);
            const original = copyBtn.title;
            copyBtn.classList.add('copied');
            copyBtn.title = 'Copied';
            setTimeout(() => {
              copyBtn.classList.remove('copied');
              copyBtn.title = original;
            }, 1500);
          } catch {
            // Clipboard access denied — the mailto link still works.
          }
        });

        field.replaceChildren(link, copyBtn);
      },
      { once: true },
    );
  });
</script>
