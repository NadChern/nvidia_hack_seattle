---
import { team } from '../data/team';
---
<section id="team">
  <div class="container">
    <p class="section-kicker">The team</p>
    <h2 class="section-title">The people building MEMO.</h2>
    <p class="section-sub">Reach any of us directly to learn more.</p>

    <div class="team-grid">
      {
        team.map((member) => (
          <div class="member">
            <div
              class="member-avatar"
              style={`background: hsl(${member.hue} 66% 66%);`}
              aria-hidden="true"
            >
              {member.initials}
            </div>
            <div class="member-name">{member.name}</div>
            <div class="member-links">
              {
                member.linkedin && (
                  <a href={member.linkedin} target="_blank" rel="noopener noreferrer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.5 8.5h4.5V24H.5zM8.5 8.5h4.3v2.1h.06c.6-1.14 2.06-2.34 4.24-2.34 4.53 0 5.36 2.98 5.36 6.85V24h-4.5v-7.4c0-1.76-.03-4.03-2.46-4.03-2.46 0-2.84 1.92-2.84 3.9V24H8.5z"/></svg>
                    LinkedIn
                  </a>
                )
              }
              <a href={member.github} target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.54-3.87-1.54-.53-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
                GitHub
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p class="status-note">Message any of us directly about what we are building.</p>
  </div>
</section>
