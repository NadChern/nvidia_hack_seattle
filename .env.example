# Visual Memory Assistant — safe local example
#
# Copy only if you want explicit settings:
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# scripts/dev_stack.sh generates local LiveKit credentials automatically when
# .env is absent. Values below are development-only and MUST be replaced for a
# trusted-LAN or GN100 deployment. Never commit the resulting .env.

VMA_ENVIRONMENT=dev
VMA_BIND_ADDR=127.0.0.1
VMA_MEDIA_SOURCE=livekit
VMA_SAMPLE_FPS=8

# Local LiveKit credentials. The secret is intentionally a non-production
# example but is long enough for development validation.
VMA_LIVEKIT_API_KEY=vma-local
VMA_LIVEKIT_API_SECRET=local-only-change-before-deploy-0123456789abcdef
VMA_LIVEKIT_URL=ws://127.0.0.1:7880
VMA_LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880

# CPU-safe/offline profile. No hosted model API key is required.
VMA_AGENT_BACKEND=stub
VMA_REASON_KIND=fixture
VMA_IDENTITY_KIND=fixture
VMA_TTS_BACKEND=stub
VMA_DETECTION_LABELS=keys,wallet,frames

# Trusted-LAN / physical-glasses deployment (replace and uncomment).
# VMA_ENVIRONMENT=deploy
# VMA_BIND_ADDR=192.168.1.42
# VMA_INTERNAL_API_TOKEN=generate-a-long-random-token
# VMA_DEVICE_ID_ALLOWLIST=x3-your-device-id
# VMA_LIVEKIT_PUBLIC_URL=ws://192.168.1.42:7880

# Local real-model endpoints on the GN100. These are not cloud API URLs.
# Start and validate the pinned model servers/caches before the stack.
# VMA_AGENT_BACKEND=llm
# VMA_LLM_BASE_URL=http://127.0.0.1:8000/v1
# VMA_LLM_MODEL=openai/nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# VMA_REASON_KIND=cosmos
# VMA_REASON_BASE_URL=http://127.0.0.1:8001/v1
# VMA_REASON_MODEL=nvidia/Cosmos3-Nano
# VMA_IDENTITY_KIND=radio
# VMA_IDENTITY_DEVICE=cuda
# VMA_TTS_BACKEND=auto

# Only external LLM evaluation profiles require these. The default local demo
# rejects external endpoints unless the opt-in is explicit.
# VMA_ALLOW_EXTERNAL_LLM=true
# VMA_LLM_API_KEY=read-secret-without-shell-history

# A Hugging Face token may be needed only to download a model whose publisher
# requires authentication. It is not needed at runtime once the approved cache
# is populated. Never place a real token in this example.
# HF_TOKEN=replace-me
